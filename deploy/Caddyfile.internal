# Caddy internal untuk docker-compose.nginx.yml: HTTP saja, berada di belakang nginx server.
# HTTPS (sertifikat) diurus nginx + certbot, bukan Caddy.
{
	auto_https off
	admin off
	servers {
		# Percayai X-Forwarded-Proto/For dari nginx server (datang lewat jaringan Docker/localhost),
		# supaya Django tahu request aslinya HTTPS (mencegah redirect tanpa henti).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	# Foto maksimal 10 MB (+ field form)
	request_body {
		max_size 12MB
	}

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# API, admin, kebijakan privasi, health check -> Django (Gunicorn)
	@django path /api /api/* /admin /admin/* /privacy /privacy/* /healthz /healthz/*
	handle @django {
		reverse_proxy backend:8000
	}

	# File statis Django (admin) dan foto hasil unggahan
	handle_path /static/* {
		root * /srv/static
		file_server
	}
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "private, max-age=86400"
		file_server
	}

	# Dashboard web
	handle {
		root * /srv/frontend
		file_server
	}
}
