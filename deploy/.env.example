# Salin ke deploy/.env lalu isi semua nilai:  cp .env.example .env
# File deploy/.env berisi rahasia dan TIDAK boleh di-commit.

# Domain yang sudah diarahkan (DNS A record) ke IP server, tanpa https://
DOMAIN=roadpulse.contoh.id
# Email untuk pemberitahuan sertifikat Let's Encrypt
ACME_EMAIL=admin@contoh.id

# Buat dengan: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=

# Database PostgreSQL (dibuat otomatis oleh container db)
DB_NAME=roadpulse
DB_USER=roadpulse
# Buat dengan: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=

# Email kontak yang tampil di halaman /privacy/ (Kebijakan Privasi)
PRIVACY_CONTACT_EMAIL=

# Opsional
# GUNICORN_WORKERS=2          # ±300 MB RAM per worker karena model AI
# THROTTLE_CLASSIFY=120/hour  # batas unggah foto per akun
# CORS_ALLOWED_ORIGINS=       # hanya bila dashboard dihosting di domain lain, mis. https://dashboard.contoh.id

# Khusus server bersama (docker-compose.nginx.yml): port lokal 127.0.0.1 yang belum dipakai
# (cek: sudo ss -tlnp | grep :8086). Samakan dengan proxy_pass di nginx/roadpulse.conf.
# ROADPULSE_PORT=8086
