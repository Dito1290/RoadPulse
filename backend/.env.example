# Salin ke backend/.env lalu sesuaikan:  cp .env.example .env
# File .env tidak di-commit (lihat .gitignore).

SECRET_KEY=ganti-dengan-kunci-acak
DEBUG=True
# IP LAN komputer otomatis diizinkan saat DEBUG=True (ikut berubah saat ganti Wi-Fi/hotspot)
ALLOWED_HOSTS=127.0.0.1,localhost

# Database PostgreSQL (default). Pakai SQLite: jalankan DB_ENGINE=sqlite ./start.sh
DB_NAME=Roadpulse_db
DB_USER=postgres
DB_PASSWORD=roadpulse
DB_HOST=127.0.0.1
DB_PORT=5432

# Kontak di halaman /privacy/ (Kebijakan Privasi)
# PRIVACY_CONTACT_EMAIL=
# Batas unggah foto per akun (default 120/hour)
# THROTTLE_CLASSIFY=120/hour
# Produksi: pakai deploy/ (Docker). Lihat deploy/README.md
