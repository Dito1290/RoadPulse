{
  "expo": {
    "name": "RoadPulse",
    "slug": "roadpulse",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "RoadPulse memakai kamera untuk memotret kondisi permukaan jalan.",
        "NSLocationWhenInUseUsageDescription": "RoadPulse memakai lokasi untuk mencatat titik foto jalan di peta."
      },
      "bundleIdentifier": "id.ac.polinela.roadpulse"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#20C997",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "id.ac.polinela.roadpulse"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan RoadPulse memakai kamera untuk memotret kondisi jalan."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan RoadPulse memakai lokasi untuk mencatat titik foto jalan."
        }
      ],
      "expo-status-bar",
      "expo-video"
    ]
  }
}
